{
  "name": "kinetic-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic kinetic typography Reel generator (Remotion + React + TypeScript)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Reel out/reel.mp4",
    "still": "remotion still Reel out/frame.png --frame=60",
    "sync": "node scripts/sync-from-transcript.mjs",
    "audio:placeholders": "bash scripts/make-placeholder-audio.sh",
    "typecheck": "tsc --noEmit",
    "cover": "remotion still Cover out/cover.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
